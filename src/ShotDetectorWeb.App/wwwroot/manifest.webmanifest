{
  "id": "./",
  "name": "Shot detection in the browser",
  "short_name": "ShotDetector",
  "description": "Finds the shots in an MP4 or an AVI on WebAssembly, with scenedetect's results byte for byte. Nothing leaves the machine.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fafaf9",
  "theme_color": "#1d4ed8",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "video/mp4": [".mp4"],
        "video/x-msvideo": [".avi"]
      },
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "video", "accept": ["video/mp4", "video/x-msvideo", "video/avi", ".mp4", ".avi"] }
      ]
    }
  }
}
