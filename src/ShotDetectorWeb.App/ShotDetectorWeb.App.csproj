<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The page's .NET side on browser-wasm: Api's [JSExport]s, called from wwwroot/worker.js, and under Node by
    tools/app-check.mjs, which checks their CSVs against the native check's (README, Checks). Needs the wasm-tools
    workload (dotnet workload install wasm-tools); publish it on its own (dotnet publish src/ShotDetectorWeb.App), not
    as part of a solution.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ShotDetectorWeb.App</RootNamespace>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- _framework/ keeps the assemblies' own names (ShotDetector.FastYuv.wasm, LGPL-2.1: its own, replaceable file),
         not names with a content hash in them. -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <!-- No ICU data in the bundle (icudt_*.dat, about 200 KB of the first load): the CSVs and the options are
         culture-invariant already, which tools/check.sh wasm proves against the native run. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No .br/.gz copies next to each file: GitHub Pages compresses every response itself and never serves them
         (README "Size"). -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShotDetectorWeb.Core\ShotDetectorWeb.Core.csproj" />
  </ItemGroup>

  <!-- A replaced FastYuv (-p:FastYuvAssembly, the core csproj and README "Licensing") goes into the bundle in place of
       the package's, which the core then leaves out. -->
  <ItemGroup Condition="'$(FastYuvAssembly)' != ''">
    <Reference Include="ShotDetector.FastYuv" HintPath="$(FastYuvAssembly)" />
  </ItemGroup>

</Project>
