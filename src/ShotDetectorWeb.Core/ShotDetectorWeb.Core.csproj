<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shot detection without FFmpeg: ManagedCodecs demuxes and decodes the MP4, ShotDetector.FastYuv converts, ShotDetector
    detects; ManagedCodecs' AAC decoder decodes the sound that Mp4Audio measures. Runs natively and on browser-wasm. ShotDetector.FastYuv is LGPL-2.1 and stays its own DLL (README, Licensing).
  -->
  <PropertyGroup>
    <RootNamespace>ShotDetectorWeb</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ShotDetector" />
    <PackageReference Include="ShotDetector.FastYuv" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Replacing FastYuv (LGPL-2.1, README "Licensing"): -p:FastYuvAssembly=<a ShotDetector.FastYuv.dll built from its
       source> builds against that one instead of the package's, which then only supplies the license text. -->
  <ItemGroup Condition="'$(FastYuvAssembly)' != ''">
    <PackageReference Update="ShotDetector.FastYuv" ExcludeAssets="compile;runtime" />
    <Reference Include="ShotDetector.FastYuv" HintPath="$(FastYuvAssembly)" />
  </ItemGroup>

  <!-- FastYuv's license goes wherever its DLL goes (LGPL-2.1: the notice ships with the library). -->
  <ItemGroup>
    <None Include="$(PkgShotDetector_FastYuv)/COPYING.LGPL" Link="licenses/ShotDetector.FastYuv/COPYING.LGPL" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\ManagedCodecs\src\ManagedCodecs.Aac\ManagedCodecs.Aac.csproj" />
    <ProjectReference Include="..\..\external\ManagedCodecs\src\ManagedCodecs.Containers\ManagedCodecs.Containers.csproj" />
    <ProjectReference Include="..\..\external\ManagedCodecs\src\ManagedCodecs.H264\ManagedCodecs.H264.csproj" />
  </ItemGroup>

</Project>
